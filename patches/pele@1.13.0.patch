+import { e as shapeInset } from "./6PIGVMFT.js";
+import { G as num } from "./STHDNR4A.js";
+
+const LOOP_GAP = 8;
+
+export function flowchartLoop(node, view, loops, sideways, base, trim, edge) {
+  const previous = loops.get(edge.src);
+  const index = previous?.count ?? 0;
+  const outset = previous?.outset ?? 0;
+  const labelExtent = sideways ? edge.labelH : edge.labelW;
+  // The renderer already reserves room for every loop and its label on this axis.
+  // Reserve each label's span before placing the next loop, even when the label is long.
+  loops.set(edge.src, { count: index + 1, outset: outset + labelExtent + LOOP_GAP });
