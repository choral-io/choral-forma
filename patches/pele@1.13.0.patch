+  const side = sideways ? 2 : 1;
+  const spread = Math.max(0, Math.min((sideways ? w : h) / 2 - 4, 8 + index * 6));
+  const reach = base + outset;
+  // At the midpoint of a cubic, the two handles carry three quarters of the weight.
+  // Widen the handles to keep the next arc near its own label as the outset grows.
+  const handle = base + (4 / 3) * outset;
+  const sideOffset = (sideways ? h : w) / 2;
+  const startOut = -shapeInset(shape, w, h, side, -spread);
+  const endOut = -shapeInset(shape, w, h, side, spread);
+  const endLead = handle - endOut;
+  const length = Math.hypot(endLead, spread) || 1;
+  const at = (out, along) => sideways
+    ? [node.x + along, node.y + sideOffset + out]
+    : [node.x + sideOffset + out, node.y + along];
+  const point = (out, along) => at(out, along).map(num).join(",");
+  const [sx, sy] = at(startOut, -spread);
+  const [ex, ey] = at(endOut, spread);
+  const trimOut = endLead / length * trim;
+  const trimAlong = spread / length * trim;
+  const [labelX, labelY] = at(reach + 4 + labelExtent / 2, 0);
+  edge.labelX = labelX;
+  edge.labelY = labelY;
+  return {
+    d: `M${point(startOut, -spread)}C${point(handle, -2 * spread)} ${point(handle, 2 * spread)} ${point(endOut + trimOut, spread + trimAlong)}`,
+    sx, sy, ex, ey,
+    sdx: sideways ? 0 : -1,
+    sdy: sideways ? -1 : 0,
+    edx: -(sideways ? spread : endLead) / length,
+    edy: -(sideways ? endLead : spread) / length,
+  };
+}
