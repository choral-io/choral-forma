{
  "name": "@choral-forma/graph-view",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint . --cache --cache-location node_modules/.tmp/.eslintcache",
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir dist",
    "benchmark": "vitest bench src/layout.bench.ts --run",
    "check": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "graphology": "~0.26.0",
    "graphology-layout-force": "~0.2.4",
    "graphology-layout-forceatlas2": "~0.10.1",
    "sigma": "~3.0.3"
  },
  "devDependencies": {
    "tsdown": "~0.22.7"
  }
}
