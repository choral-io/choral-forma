{
  "name": "@choral-forma/temporal-view",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./preview.css": "./dist/preview.css"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/runtime.ts --format esm --dts --clean --out-dir dist && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.tmp/.eslintcache",
    "test": "vitest run --root ../.. packages/temporal-view/src"
  },
  "dependencies": {
    "@choral-forma/shared": "workspace:*",
    "lucide-react": "~1.48.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "~5.20.8",
    "@tailwindcss/vite": "~4.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "daisyui": "~5.7.46",
    "eslint-plugin-better-tailwindcss": "~4.7.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.12.0",
    "tailwindcss": "~4.3.3",
    "tsdown": "~0.23.0",
    "vite": "~8.3.1"
  }
}
