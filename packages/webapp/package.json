    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "daisyui": "~5.8.3",
    "eslint-plugin-better-tailwindcss": "~4.11.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.5.8",
    "globals": "~17.14.0",
    "lucide-static": "~1.82.0",
    "oxc-transform-react": "~0.156.0",
    "subset-font": "~2.9.0",
    "tailwindcss": "~4.3.5",
    "vite": "~8.4.0"
  }
