  "scripts": {
    "dev": "vite",
    "lint": "eslint . --cache --cache-location node_modules/.tmp/.eslintcache",
    "build": "tsc -b && vite build && vite build --mode static --outDir dist-static",
    "check": "tsc --noEmit",
    "preview": "vite preview",
