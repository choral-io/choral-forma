    "test:mermaid-worker-upgrade": "node scripts/mermaid-worker-upgrade-gate.mjs",
    "generate:link-icon-font": "node scripts/generate-link-icon-font.mjs"
  },
  "dependencies": {
    "@choral-forma/graph-view": "workspace:*",
    "@choral-forma/shared": "workspace:*",
    "@choral-forma/temporal-view": "workspace:*",
    "@shikijs/langs": "~4.6.0",
    "@shikijs/themes": "~4.6.0",
    "clsx": "~2.1.1",
    "date-fns": "~4.4.0",
    "dompurify": "~3.5.0",
    "katex": "~0.19.1",
    "lucide-react": "~1.82.0",
    "marked": "~18.3.0",
    "marked-footnote": "~1.4.0",
    "pele": "~1.13.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router": "~8.5.3",
    "shiki": "~4.6.0",
    "tailwind-merge": "~3.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "~5.30.6",
    "@tailwindcss/typography": "~0.5.20",
    "@tailwindcss/vite": "~4.3.5",
