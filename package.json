{
  "name": "@choral-forma/workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/choral-io/choral-forma.git"
  },
  "scripts": {
    "lint": "pnpm --recursive --if-present lint",
    "build": "pnpm --recursive --if-present build",
    "test": "vitest run extensions/vscode/src packages/graph-view/src packages/shared/src packages/webapp/src && node --test scripts/*.test.mjs",
    "check": "node scripts/check-release-version.mjs && pnpm --recursive --if-present check && prettier --check . --cache",
    "format": "prettier --write . --cache",
    "site:deploy": "wrangler deploy",
    "site:deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.6",
    "jsdom": "~29.1.1",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.65.0",
    "vitest": "~4.1.10",
    "wrangler": "~4.114.0",
    "yaml": "~2.9.0"
  }
}
