{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "choral-forma-site",
    "compatibility_date": "2026-07-28",
    "workers_dev": true,
    "preview_urls": true,
    "routes": [
        {
            "pattern": "forma.choral.io",
            "custom_domain": true,
        },
    ],
    "assets": {
        "directory": "./dist/site",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
    },
}
