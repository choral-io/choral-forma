{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acknowledgement window fixture events",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "cases"],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["staging", "production-like"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "delaySeconds", "replayed", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "delaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "replayed": {
          "type": "boolean"
        },
        "expected": {
          "type": "string",
          "enum": ["accepted", "rejected"]
        }
      }
    }
  }
}
